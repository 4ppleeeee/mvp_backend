TRIPGUARD_BACKEND_PORT=18080
TRIPGUARD_PUBLIC_BASE_URL=https://trip.aatroxli.site:1221
TRIPGUARD_LLM_MODEL=gemma4:latest
TRIPGUARD_REQUEST_TIMEOUT_SECONDS=120
# Enable evidence retrieval only after the Ollama embedding model is available.
TRIPGUARD_RAG_ENABLED=false
# This model is served by the same Ollama endpoint as the chat model.
TRIPGUARD_RAG_EMBEDDING_MODEL=nomic-embed-text
# Local development path; Docker Compose overrides this to the persistent /data/rag volume.
TRIPGUARD_RAG_PERSIST_DIR=./data/rag
TRIPGUARD_INGESTION_MAX_UPLOAD_BYTES=536870912
# Optional media-only egress for retrying blocked public video extraction.
# Keep credentials in the private deployment env file; never expose this value in logs or API responses.
TRIPGUARD_MEDIA_PROXY_URL=
TRIPGUARD_VIDEO_KEYFRAMES_ENABLED=false
TRIPGUARD_VIDEO_FRAME_INTERVAL_SECONDS=6
TRIPGUARD_VIDEO_GRID_ROWS=2
TRIPGUARD_VIDEO_GRID_COLUMNS=2
# Keep the three following values only in the private deployment .admin.env.
# Generate the password hash with: python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash(input()))"
TRIPGUARD_ADMIN_USERNAME=
TRIPGUARD_ADMIN_PASSWORD_HASH=
TRIPGUARD_ADMIN_SESSION_SECRET=
